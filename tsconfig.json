{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["office-js", "office-runtime"],
    "paths": {
      "@sectors/core": ["./packages/core/src"],
      "@sectors/core/*": ["./packages/core/src/*"],
      "@sectors/adapter-excel": ["./packages/adapter-excel/src"],
      "@sectors/adapter-excel/*": ["./packages/adapter-excel/src/*"],
      "@sectors/client": ["./packages/client/src"],
      "@sectors/client/*": ["./packages/client/src/*"],
    },
  },
  "include": ["packages", "deployments"],
}
