{
  "name": "sectors-excel-addin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "deployments/*"
  ],
  "scripts": {
    "dev": "vite --config deployments/excel/vite.config.ts",
    "build": "npm run generate:functions && tsc --noEmit && vite build --config deployments/excel/vite.config.ts",
    "preview": "vite preview --config deployments/excel/vite.config.ts",
    "generate:schema": "npx tsx scripts/generate_schema.ts",
    "generate:functions": "npx tsx scripts/generate_functions.ts",
    "generate": "npm run generate:schema && npm run generate:functions",
    "start": "office-addin-debugging start deployments/excel/manifest.xml",
    "stop": "office-addin-debugging stop deployments/excel/manifest.xml",
    "validate": "office-addin-manifest validate deployments/excel/manifest.xml"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toggle": "^1.1.12",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/office-js": "^1.0.377",
    "@types/office-runtime": "^1.0.38",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.5.2",
    "custom-functions-metadata": "^2.2.2",
    "office-addin-debugging": "^6.1.1",
    "office-addin-dev-certs": "^2.0.9",
    "office-addin-manifest": "^2.1.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
